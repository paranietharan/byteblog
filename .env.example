POSTGRES_VERSION=17.10-alpine
POSTGRES_DB=byteblog
POSTGRES_USER=byteblog
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST_PORT=5432
POSTGRES_VOLUME_NAME=byteblog_postgres_data

APP_IMAGE_NAME=byteblog-api:local
APP_HOST_PORT=8080
SERVER_PORT=8080
SHUTDOWN_TIMEOUT=30s
DOCKER_DB_URL=jdbc:postgresql://postgres:5432/byteblog

DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

JWT_SECRET=replace-with-at-least-32-random-characters-before-running
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Byteblog
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

APP_API_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom
